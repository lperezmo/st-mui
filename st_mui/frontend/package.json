{
  "name": "st-mui-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build.mjs",
    "build:dev": "NODE_ENV=development bun build.mjs",
    "dev": "NODE_ENV=development bun build.mjs --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun fmt --check . && bun lint --max-warnings 0 && bun run typecheck && bun test"
  },
  "packageManager": "bun@1.4.4",
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.1.0",
    "@mui/x-data-grid": "^8.29.2",
    "@mui/x-date-pickers": "^8.3.0",
    "@mui/x-tree-view": "^8.27.2",
    "@streamlit/component-v2-lib": "^0.2.0",
    "dayjs": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "1.4.4",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^5.8.3",
    "vite": "^8.1.4"
  }
}
