{
  "name": "st-mui-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:dev": "cross-env NODE_ENV=development node build.mjs",
    "dev": "cross-env NODE_ENV=development node build.mjs --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.ts\" build.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"test/**/*.ts\" build.mjs"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.1.0",
    "@mui/x-data-grid": "^8.29.2",
    "@mui/x-date-pickers": "^8.3.0",
    "@mui/x-tree-view": "^8.27.2",
    "@streamlit/component-v2-lib": "^0.2.0",
    "dayjs": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.14.1",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^6.0.3",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.0",
    "typescript": "^5.8.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.11"
  }
}
